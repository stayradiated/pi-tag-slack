# Bootstrap configuration for pi-tag-slack.
# Setup writes this file with mode 0600. It contains only Slack tokens.

# Bot User OAuth token from Slack OAuth & Permissions (xoxb-...).
SLACK_BOT_TOKEN="xoxb-your-bot-token-here"

# App-level Socket Mode token with connections:write (xapp-...).
SLACK_APP_TOKEN="xapp-your-app-token-here"

# Optional deployment path overrides must be exported in the process/service
# environment. They are shown here for discoverability, but are not bootstrap
# file entries.
# PI_TAG_SLACK_CONFIG="/private/path/to/config.env"
# PI_TAG_SLACK_DATA_DIR="/private/path/to/data"
